generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------
// Legacy / Storefront Mock Models (Should be migrated to Shopify API)
// ----------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                String           @id @default(uuid())
  title             String
  slug              String           @unique
  subtitle          String?
  description       String
  price             Float
  images            String
  hoverImage        String?
  inventory         Int              @default(0)
  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id])
  
  craftOrigin       String?
  giStatus          String?
  craftRegion       String?
  artisanCluster    String?
  material          String?
  technique         String?
  careInstructions  String?
  countryOfOrigin   String           @default("India")
  
  dispatchType      String           @default("Ready to Ship")
  shippingNote      String?
  packagingNote     String?
  returnEligibility String           @default("Eligible for return within 7 days")
  sku               String?          @unique
  tags              String?
  seoTitle          String?
  seoDescription    String?
  metafields        String?
  
  variants          ProductVariant[]
  orderItems        OrderItem[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  type      String
  value     String
  sku       String?
  inventory Int      @default(10)
}

model Order {
  id                String      @id @default(uuid())
  razorpayId        String?     @unique
  razorpayPaymentId String?     @unique
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String?
  address           String
  city              String
  postalCode        String
  country           String
  status            String      @default("PENDING")
  total             Float
  shippingCost      Float       @default(0)
  orderItems        OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}


// ----------------------------------------------------------------------
// Advanced Elite E-Commerce Middleware Models (PostgreSQL Specific)
// ----------------------------------------------------------------------

model ApiIntegration {
  id                   String   @id @default(uuid())
  providerName         String
  providerType         String   // payment, shipping_rate, tracking, duties_tax, email
  enabled              Boolean  @default(true)
  mode                 String   @default("test") // test or live
  credentialsReference String?  // Encrypted reference or env var key
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  @@map("api_integrations")
}

model ShippingRateQuote {
  id                       String   @id @default(uuid())
  cartToken                String?
  shopifyCheckoutId        String?
  destinationCountry       String
  destinationPostalCode    String
  totalWeightGrams         Int
  packageDimensionsJson    Json?
  provider                 String
  serviceName              String
  shippingCost             Float
  dutiesEstimate           Float?
  taxEstimate              Float?
  currency                 String
  estimatedDaysMin         Int?
  estimatedDaysMax         Int?
  quoteExpiresAt           DateTime?
  rawResponseReference     String?
  createdAt                DateTime @default(now())

  @@map("shipping_rate_quotes")
}

model Shipment {
  id                      String   @id @default(uuid())
  shopifyOrderId          String
  orderName               String?
  provider                String
  serviceName             String?
  shipmentId              String?
  trackingNumber          String?
  trackingUrl             String?
  labelUrl                String?
  status                  String   @default("PENDING")
  estimatedDeliveryDate   DateTime?
  dispatchedAt            DateTime?
  deliveredAt             DateTime?
  lastTrackingSyncAt      DateTime?
  rawTrackingReference    String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  trackingEvents          TrackingEvent[]

  @@map("shipments")
}

model TrackingEvent {
  id                  String   @id @default(uuid())
  shipmentId          String
  shipment            Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  eventStatus         String
  eventDescription    String?
  eventLocation       String?
  eventTime           DateTime?
  providerEventCode   String?
  createdAt           DateTime @default(now())

  @@map("tracking_events")
}

model OrderOperation {
  id                  String   @id @default(uuid())
  shopifyOrderId      String   @unique
  qualityCheckStatus  String   @default("PENDING") // PENDING, PASSED, FAILED
  packagingStatus     String   @default("PENDING") // PENDING, PACKED
  pickPackStatus      String   @default("PENDING")
  dispatchStatus      String   @default("PENDING") // PENDING, DISPATCHED
  assignedStaff       String?
  internalNotes       String?
  riskFlag            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("order_operations")
}

model DamageClaim {
  id                     String   @id @default(uuid())
  shopifyOrderId         String
  customerEmail          String
  claimStatus            String   @default("OPEN") // OPEN, REVIEWING, RESOLVED, REJECTED
  productPhotos          Json?    // Array of URLs
  innerPackagingPhotos   Json?
  outerPackagingPhotos   Json?
  shippingLabelPhoto     String?
  customerMessage        String?
  resolutionType         String?  // REFUND, REPLACEMENT
  refundReference        String?
  replacementOrderId     String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("damage_claims")
}

model ProductCraftRegistry {
  id                  String   @id @default(uuid())
  shopifyProductId    String   @unique
  giStatus            String?
  craftRegion         String?
  craftState          String?
  craftTechnique      String?
  giReference         String?
  verificationStatus  String   @default("PENDING") // PENDING, VERIFIED
  verificationNotes   String?
  sourceDocuments     Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("product_craft_registry")
}

model AuditLog {
  id             String   @id @default(uuid())
  actorType      String   // SYSTEM, ADMIN, WEBHOOK
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  oldValueJson   Json?
  newValueJson   Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@map("audit_logs")
}
